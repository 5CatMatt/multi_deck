    "display": "icon_text"
  },
  "pages": [
    {
      "id": "launch",
      "title": "Launch",
      "type": "grid",
      "grid": {
        "cols": 4,
        "rows": 3
      },
      "buttons": [
        {
          "id": "launch.vscode",
          "label": "VS Code",
          "action": {
            "type": "launch",
            "target": "code"
          }
        },
        {
          "id": "launch.explorer",
          "label": "Explorer",
          "icon": "directory",
          "action": {
            "type": "launch",
            "target": "explorer.exe"
          }
        },
        {
          "id": "launch.terminal",
          "label": "Terminal",
          "icon": "keyboard",
          "action": {
            "type": "launch",
            "target": "wt.exe"
          }
        },
        {
          "id": "launch.browser",
          "label": "Browser",
          "action": {
            "type": "launch",
            "target": "https://github.com"
          }
        },
        {
          "id": "macro.email",
          "label": "Email",
          "icon": "envelope",
          "action": {
            "type": "hid_text",
            "text": "you@example.com"
          }
        },
        {
          "id": "macro.print",
          "label": "Print",
          "icon": "download",
          "action": {
            "type": "seq",
            "steps": [
              {
                "type": "launch",
                "target": "https://www.printables.com/"
              },
              {
                "type": "delay",
                "ms": 2500
              },
              {
                "type": "hid",
                "keys": [
                  "CTRL",
                  "d"
                ]
              }
            ]
          }
        },
        {
          "id": "win.snap_left",
          "label": "Snap L",
          "icon": "left",
          "action": {
            "type": "ahk",
            "fn": "SnapLeft"
          }
        },
        {
          "id": "win.snap_right",
          "label": "Snap R",
          "icon": "right",
          "action": {
            "type": "ahk",
            "fn": "SnapRight"
          }
        },
        {
          "id": "sys.lock",
          "label": "Lock",
          "action": {
            "type": "hid",
            "keys": [
              "GUI",
              "l"
            ]
          }
        },
        {
          "id": "sys.taskmgr",
          "label": "Task Mgr",
          "icon": "list",
          "action": {
            "type": "hid",
            "keys": [
              "CTRL",
              "SHIFT",
              "ESC"
            ]
          }
        },
        {
          "id": "sys.desktop",
          "label": "Desktop",
          "icon": "home",
          "action": {
            "type": "hid",
            "keys": [
              "GUI",
              "d"
            ]
          }
        },
        {
          "id": "nav.macros",
          "label": "Macros",
          "icon": "right",
          "action": {
            "type": "page",
            "target": "macros"
          }
        }
      ]
    },
    {
      "id": "macros",
      "title": "Macros",
      "type": "grid",
      "grid": {
        "cols": 4,
        "rows": 3
      },
      "buttons": [
          {
          "id": "ui.theme",
          "label": "Theme >",
          "icon": "tint",
          "action": {
            "type": "theme",
            "target": "next"
          },
          "hold": {
            "type": "theme",
            "target": "Midnight"
          }
        },
        {
          "id": "media.mute",
          "label": "Mute",
          "icon": "mute",
          "action": {
            "type": "media",
            "key": "mute"
          }
        },
        {
          "id": "edit.undo",
          "label": "Undo",
          "icon": "refresh",
          "action": {
            "type": "hid",
            "keys": [
              "CTRL",
              "z"
            ]
          }
        },
        {
          "id": "edit.redo",
          "label": "Redo",
          "icon": "ok",
          "action": {
            "type": "hid",
            "keys": [
              "CTRL",
              "y"
            ]
          }
        },
        {
          "id": "launch.notepad",
          "label": "Notepad",
          "icon": "file",
          "action": {
            "type": "launch",
            "target": "notepad.exe"
          }
        },
        {
          "id": "launch.calc",
          "label": "Calc",
          "icon": "plus",
          "action": {
            "type": "launch",
            "target": "calc.exe"
          }
        },
        
        {
          "id": "sys.screenshot",
          "label": "Snip",
          "icon": "image",
          "action": {
            "type": "hid",
            "keys": [
              "GUI",
              "SHIFT",
              "s"
            ]
          }
        },
        {
          "id": "macro.paint",
          "label": "Paint",
          "icon": "image",
          "action": {
            "type": "seq",
            "steps": [
              { "type": "launch", "target": "mspaint.exe" },
              { "type": "ahk", "fn": "PasteInto", "args": ["ahk_exe mspaint.exe", "^+x"] }
            ]
          }
        },
        {
          "id": "edit.save",
          "label": "Save",
          "icon": "save",
          "action": {
            "type": "hid",
            "keys": [
              "CTRL",
              "s"
            ]
          }
        },
        {
          "id": "edit.cut",
          "label": "Cut",
          "icon": "cut",
          "action": {
            "type": "hid",
            "keys": [
              "CTRL",
              "x"
            ]
          }
        },
        {
          "id": "edit.copy",
          "label": "Copy",
          "icon": "copy",
          "action": {
            "type": "hid",
            "keys": [
              "CTRL",
              "c"
            ]
          }
        },
        {
          "id": "edit.paste",
          "label": "Paste",
          "icon": "paste",
          "action": {
            "type": "hid",
            "keys": [
              "CTRL",
              "v"
            ]
          }
        }
      ]
    },
    {
      "id": "numpad",
      "title": "Ten-Key",
      "type": "numpad"
    },
    {
      "id": "stats",
      "title": "System",
      "type": "stats"
    }
  ]
