      },
      "buttons": [
        {
          "id": "launch.vscode",
          "label": "VS Code",
          "action": {
            "type": "launch",
            "target": "code"
          }
        },
        {
          "id": "launch.terminal",
          "label": "Terminal",
          "action": {
            "type": "launch",
            "target": "wt.exe"
          }
        },
        {
          "id": "launch.explorer",
          "label": "Explorer",
          "action": {
            "type": "launch",
            "target": "explorer.exe"
          }
        },
        {
          "id": "launch.browser",
          "label": "Browser",
          "action": {
            "type": "launch",
            "target": "https://github.com"
          }
        },
        {
          "id": "launch.notepad",
          "label": "Notepad",
          "action": {
            "type": "launch",
            "target": "notepad.exe"
          }
        },
        {
          "id": "launch.calc",
          "label": "Calc",
          "action": {
            "type": "launch",
            "target": "calc.exe"
          }
        },
        {
          "id": "win.snap_left",
          "label": "Snap L",
          "action": {
            "type": "ahk",
            "fn": "SnapLeft"
          }
        },
        {
          "id": "win.snap_right",
          "label": "Snap R",
          "action": {
            "type": "ahk",
            "fn": "SnapRight"
          }
        },
        {
          "id": "sys.lock",
          "label": "Lock",
          "action": {
            "type": "hid",
            "keys": [
              "GUI",
              "l"
            ]
          }
        },
        {
          "id": "sys.taskmgr",
          "label": "Task Mgr",
          "action": {
            "type": "hid",
            "keys": [
              "CTRL",
              "SHIFT",
              "ESC"
            ]
          }
        },
        {
          "id": "sys.desktop",
          "label": "Desktop",
          "action": {
            "type": "hid",
            "keys": [
              "GUI",
              "d"
            ]
          }
        },
        {
          "id": "nav.macros",
          "label": "Macros >",
          "action": {
            "type": "page",
            "target": "macros"
          }
        }
      ]
    },
    {
      "id": "macros",
      "title": "Macros",
      "type": "grid",
      "grid": {
        "cols": 4,
        "rows": 3
      },
      "buttons": [
        {
          "id": "edit.copy",
          "label": "Copy",
          "action": {
            "type": "hid",
            "keys": [
              "CTRL",
              "c"
            ]
          }
        },
        {
          "id": "edit.paste",
          "label": "Paste",
          "action": {
            "type": "hid",
            "keys": [
              "CTRL",
              "v"
            ]
          }
        },
        {
          "id": "edit.paste_plain",
          "label": "Paste Raw",
          "action": {
            "type": "hid",
            "keys": [
              "CTRL",
              "SHIFT",
              "v"
            ]
          }
        },
        {
          "id": "edit.undo",
          "label": "Undo",
          "action": {
            "type": "hid",
            "keys": [
              "CTRL",
              "z"
            ]
          }
        },
        {
          "id": "media.prev",
          "label": "Prev",
          "action": {
            "type": "media",
            "key": "prev"
          }
        },
        {
          "id": "media.play",
          "label": "Play",
          "action": {
            "type": "media",
            "key": "play_pause"
          }
        },
        {
          "id": "media.next",
          "label": "Next",
          "action": {
            "type": "media",
            "key": "next"
          }
        },
        {
          "id": "media.mute",
          "label": "Mute",
          "action": {
            "type": "media",
            "key": "mute"
          }
        },
        {
          "id": "macro.email",
          "label": "Email",
          "action": {
            "type": "hid_text",
            "text": "you@example.com"
          }
        },
        {
          "id": "macro.standup",
          "label": "Standup",
          "action": {
            "type": "seq",
            "steps": [
              {
                "type": "launch",
                "target": "https://meet.google.com"
              },
              {
                "type": "delay",
                "ms": 2500
              },
              {
                "type": "hid",
                "keys": [
                  "CTRL",
                  "d"
                ]
              }
            ]
          }
        },
        {
          "id": "sys.screenshot",
          "label": "Snip",
          "action": {
            "type": "hid",
            "keys": [
              "GUI",
              "SHIFT",
              "s"
            ]
          }
        },
        {
          "id": "ui.theme",
          "label": "Theme >",
          "action": {
            "type": "theme",
            "target": "next"
          },
          "hold": {
            "type": "theme",
            "target": "Midnight"
          }
        }
      ]
    },
    {
      "id": "numpad",
      "title": "Ten-Key",
