__pycache__/
*.py[cod]
.venv/
venv/

# setuptools build metadata — regenerated by `pip install -e agent`.
*.egg-info/

# Generated icon binaries — rebuild with tools/make_icons.py from the PNG sources.
sdcard/icons/*.bin

# Arduino build output
build/
*.elf
*.bin.hex
build/
build-pwm/

# PyInstaller output for the theme builder. Deliberately under dist/ and not build/, which is
# already the Arduino toolchain's — sharing that name means one --clean takes out the other.
dist/

# Drawn at build time from deckhost/tray.py so the two icons cannot drift apart.
agent/deckbuilder/deckbuilder.ico
